{
    "name": "al-rahabi/fancy-crud",
    "description": "Opinionated abstract building blocks (controllers, services, repositories, actions, policies, resources) for well-structured Laravel CRUD projects.",
    "keywords": ["laravel", "crud", "repository", "service", "actions", "package"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/psr7": "^2.0",
        "laravel-notification-channels/fcm": "^6.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "maatwebsite/excel": "^3.1",
        "spatie/laravel-permission": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php",
            "src/Testing/helpers.php"
        ],
        "psr-4": {
            "FancyCrud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FancyCrud\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FancyCrud\\FancyCrudServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
